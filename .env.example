# Token da brapi.dev (opcional, gratuito)
# Obtenha em: https://brapi.dev
BRAPI_TOKEN=

# Timeout das requisições em ms (padrão: 30000)
REQUEST_TIMEOUT=30000

# Número máximo de retentativas (padrão: 3)
MAX_RETRIES=3

# URL base da brapi.dev (padrão: https://brapi.dev/api)
BRAPI_BASE_URL=https://brapi.dev/api

# URL base da CVM (padrão: https://dados.cvm.gov.br)
CVM_BASE_URL=https://dados.cvm.gov.br
